# ==============================================================================
# FairEnrol & Security Lab Platform Environment Configuration Template
# Copy this file to .env.local and adjust values for your environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenID Connect / TideCloak IAM Settings (FairEnrol & Lab Manager Auth)
# ------------------------------------------------------------------------------
# Base URL of the TideCloak / Keycloak authentication server
VITE_OIDC_URL=http://localhost:8081

# Target Realm name for FairEnrol
VITE_OIDC_REALM=fairenrol

# Public Client ID configured with Authorization Code Flow + PKCE (S256)
VITE_OIDC_CLIENT_ID=fairenrol-app

# ------------------------------------------------------------------------------
# 2. Lab Manager Control Plane Settings
# ------------------------------------------------------------------------------
# Port for Lab Manager API Server
LAB_API_PORT=4000
LAB_API_HOST=127.0.0.1

# Lab Network Scope & Isolation
LAB_TARGET_NETWORK=sec-lab-target-net
LAB_MANAGEMENT_NETWORK=sec-lab-mgmt-net

# Database connection (PostgreSQL metadata DB for Lab Manager)
LAB_DATABASE_URL=postgresql://lab_admin:lab_secure_password_demo@localhost:5432/lab_metadata

# Evidence & Artifact Retention Directory
LAB_EVIDENCE_DIR=./data/evidence
LAB_REPORTS_DIR=./data/reports
