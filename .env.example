# FairEnrol Environment Configuration Template
# Copy this file to .env.local to configure OpenID Connect (TideCloak / Keycloak)

# Base URL of the TideCloak / Keycloak authentication server (e.g. http://localhost:8081)
VITE_OIDC_URL=http://localhost:8081

# Target Realm name for FairEnrol
VITE_OIDC_REALM=fairenrol

# Public Client ID configured with Authorization Code Flow + PKCE (S256)
VITE_OIDC_CLIENT_ID=fairenrol-app
